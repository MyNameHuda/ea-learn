# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# Local database backups.
#
# The app no longer uses SQLite at all — it runs entirely on a hosted
# PostgreSQL. These exist only as a manual safety net, and they must never be
# committed or, worse, uploaded as part of a Vercel deployment.
*.db
*.db-wal
*.db-shm
/data/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
#
# .env holds the real Neon connection string and the session secret. It is
# listed here and nowhere else may be relaxed — a committed DATABASE_URL is a
# public database and a committed AUTH_SECRET is a way to mint a login cookie.
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local verification scratch — screenshots, throwaway probes, audit output.
# None of it is source, and some of it contains fixture credentials.
/.shot-tmp/

# Old UI screenshot dumps from before the redesign.
/ui-v4-screenshots/

# Uploaded question images are user content, not source. On Vercel they live in
# Blob, so this directory only exists locally in development.
/public/uploads/
